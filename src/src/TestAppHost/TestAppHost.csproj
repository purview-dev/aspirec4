<Project Sdk="Aspire.AppHost.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!--
			Single-target, unlike the libraries: an Aspire AppHost is a runnable project that Aspire
			starts with `dotnet run`, which cannot choose a target framework for it. It compiles against
			the net10.0 asset, the TFM an AppHost targets.
		-->
		<TargetFramework>net10.0</TargetFramework>
		<AspireUseCliBundle>true</AspireUseCliBundle>
		<NoWarn>$(NoWarn);CA2234;</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
		<PackageReference Include="Aspire.Hosting.Azure.Redis" />
		<PackageReference Include="Aspire.Hosting.JavaScript" />
		<PackageReference Include="Purview.Containers.Aspire" />
	</ItemGroup>

	<ItemGroup>
		<Content
			Include="..\..\..\assets\likec4-extensions\**\*"
			Link="likec4\extensions\%(RecursiveDir)%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
		/>
		<Content
			Include="..\..\..\assets\images\**\*"
			Link="likec4\images\%(RecursiveDir)%(Filename)%(Extension)"
			CopyToOutputDirectory="PreserveNewest"
		/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AspireC4\AspireC4.csproj" IsAspireProjectResource="false" />
		<ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.csproj" IsAspireProjectResource="false" />
		<!-- An Aspire project resource: this one owns the sample EF Core models. -->
		<ProjectReference Include="..\TestAppHost.DataService\TestAppHost.DataService.csproj" />
		<ProjectReference
			Include="..\SourceGenerators\SourceGenerators.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			IsAspireProjectResource="false"
		/>
	</ItemGroup>
</Project>
