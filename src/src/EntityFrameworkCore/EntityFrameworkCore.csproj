<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<AssemblyTitle>AspireC4 Hosting Entity Framework Core</AssemblyTitle>
		<Description>Aspire hosting extension for AspireC4, generating a live d2lang ER diagram from Entity Framework Core DbContext types.</Description>
		<COPYRIGHT_YEAR>2026</COPYRIGHT_YEAR>
		<PackageId>AspireC4.Hosting.EntityFrameworkCore</PackageId>
		<Title>AspireC4.Hosting.EntityFrameworkCore - Aspire d2lang ER Visualisation</Title>
		<Authors>Purview Contributors</Authors>
		<Copyright>Purview-Dev., $(COPYRIGHT_YEAR) | All rights reserved.</Copyright>
		<PackageIcon>likec4-logo.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/purview-dev/aspirec4</RepositoryUrl>
		<PackageProjectUrl>$(PurviewProjectUrl)</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>aspire;dotnet;aspnetcore;d2;d2lang;entityframework;efcore;erd;diagram;visualisation;visualization;</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
	</PropertyGroup>

	<ItemGroup>
		<None
			Include="$(MSBuildThisFileDirectory)..\..\..\assets\images\likec4\likec4-logo.png"
			Link="Sdk/likec4-logo.png"
		/>
		<None Include="$(MSBuildThisFileDirectory)..\..\..\README.md" Link="Sdk/README.md" />
	</ItemGroup>

	<ItemGroup>
		<!-- Viewer assets stay real files so they remain lintable; they are emitted at generation time. -->
		<EmbeddedResource Include="Assets\viewer\index.html" />
		<EmbeddedResource Include="Assets\viewer\app.js" />
		<EmbeddedResource Include="Assets\mermaid\index.html" />
		<EmbeddedResource Include="Assets\mermaid\mermaid-app.js" />
		<!--
			Gzipped so the package carries roughly 2 MB rather than 7 MB. Regenerate after a
			dependency bump by running the erd-vendor script in embed mode.
		-->
		<EmbeddedResource Include="Assets\viewer\vendor\bundle.js.gz" />
		<EmbeddedResource Include="Assets\viewer\vendor\mermaid.js.gz" />
		<EmbeddedResource Include="Assets\viewer\vendor\reactflow.css.gz" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" />
		<!-- Reflection-only metadata reads for the analyzer-less discovery path. -->
		<PackageReference Include="System.Reflection.MetadataLoadContext" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AspireC4\AspireC4.csproj" IsAspireProjectResource="false" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Aspire.Hosting.ApplicationModel" />
	</ItemGroup>
</Project>
