<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<AssemblyTitle>AspireC4 Hosting</AssemblyTitle>
		<Description>Aspire hosting extension for the AspireC4 plugin, generating a dynamic LikeC4 architecture diagram for your Aspire application.</Description>
		<COPYRIGHT_YEAR>2026</COPYRIGHT_YEAR>
		<PackageId>AspireC4.Hosting</PackageId>
		<Title>AspireC4.Hosting - Aspire LikeC4 Visualisation</Title>
		<Authors>Purview Contributors</Authors>
		<Copyright>Purview-Dev., $(COPYRIGHT_YEAR) | All rights reserved.</Copyright>
		<PackageIcon>likec4-logo.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/purview-dev/aspirec4</RepositoryUrl>
		<PackageProjectUrl>$(PurviewProjectUrl)</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>aspire;dotnet;aspnetcore;c4;likec4;architecture;diagram;visualisation;visualization;</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<!--
			NU5104 rejects a stable package that depends on a prerelease one. The only prerelease in
			the graph is Purview.Containers.Environment, which has no stable release yet (latest is
			1.0.0-prerelease.13) and is used solely for the image-export bind-sharing probe. The
			dependency is deliberate and resolved by NuGet, so suppress the specific warning rather
			than force a fake stable dependency; remove this when Purview.Containers ships 1.0.0.
		-->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
		<!--
			RS0026 (PublicApiAnalyzers) rejects a member group with more than one overload carrying
			optional parameters. WithLink(string, string? = null) and WithLink(Uri, string? = null)
			are the shipped preview shape and are exported to TypeScript as distinct fluent methods;
			removing either, or splitting the optional parameter, is a public API change that would
			also change the Aspire-generated TypeScript surface. The 13.6.5 baseline records the shape
			instead, so it cannot change unnoticed.
		-->
		<NoWarn>$(NoWarn);RS0026</NoWarn>
		<!--
			Opting into the Aspire integration analysers - hoping it'll help me to
			figure out some issues with the TypeScript exports.
		-->
		<EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="BuildResources\likec4-icons.json" />
	</ItemGroup>

	<ItemGroup>
		<None
			Include="$(MSBuildThisFileDirectory)..\..\..\assets\images\likec4\likec4-logo.png"
			Link="Sdk/likec4-logo.png"
		/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" />
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
		<PackageReference Include="Purview.Containers.Environment" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\SourceGenerators\SourceGenerators.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
			IsAspireProjectResource="false"
		/>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Aspire.Hosting.ApplicationModel" />
	</ItemGroup>
</Project>
