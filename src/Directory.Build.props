<Project>
	<PropertyGroup>
		<NamespacePrefix>Aspire.Hosting.AspireC4</NamespacePrefix>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />

	<PropertyGroup>
		<!--
			Baselined on net10.0: net8.0 and net9.0 both fall out of support imminently.
			Roslyn components (SourceGenerators, EntityFrameworkCore.Analyzers) override this with
			netstandard2.0, which is required for analyzers and is unaffected by the support window.
		-->
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<NoWarn>$(NoWarn);ASPIREATS001</NoWarn>
		<ExcludeMSTelemetryExtension>true</ExcludeMSTelemetryExtension>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsTestProject)' == 'true'">
		<NoWarn>$(NoWarn);CA1034;CA2234;</NoWarn>
	</PropertyGroup>

	<PropertyGroup Label="Purview site URL metadata">
		<PurviewHomepage>https://purview.dev/</PurviewHomepage>
		<PurviewProjectUrl>$(PurviewHomepage)projects/aspirec4/</PurviewProjectUrl>
		<PurviewDocsUrl>$(PurviewHomepage)docs/aspirec4/</PurviewDocsUrl>
	</PropertyGroup>
</Project>
