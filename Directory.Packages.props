<Project>
	<!-- Version Settings -->
	<PropertyGroup>
		<RoslynCompilerVersion>5.9.0</RoslynCompilerVersion>
		<RoslynAnalyzersVersion>5.9.0</RoslynAnalyzersVersion>
		<TUnitVersion>1.83.0</TUnitVersion>
		<PurviewSourceGenVersion>2.1.0</PurviewSourceGenVersion>
		<PurviewTelemetryVersion>6.0.1</PurviewTelemetryVersion>
		<!--
			Two Aspire versions, on purpose:

			- AspireVersion is the Aspire.Hosting floor the shipped libraries compile against and
			  declare, so an AppHost on the Aspire 13 line (13.6.5+) and one on 17+ can both install
			  them; NuGet lifts a 17 AppHost's graph to its own version. Only the shipped libraries
			  reference Aspire.Hosting directly.
			- AspireAppHostVersion is what this repository's own AppHost and tests run on: the sample
			  AppHost and the integration tests exercise the 17 line, while the unit tests resolve the
			  floor through their library references and so exercise the 13 line.
		-->
		<AspireVersion>13.6.5</AspireVersion>
		<AspireAppHostVersion>17.0.0</AspireAppHostVersion>
		<PurviewContainersVersion>1.0.0-prerelease.14</PurviewContainersVersion>
		<!--
			Containers.Aspire follows the Aspire line, unlike Containers.Environment: .14 needs Aspire 17.
			The Aspire 13 sample AppHost sets both this and AspireAppHostVersion in its .csproj; PackageVersion
			items evaluate after every property, so a project's own value is the one used.
		-->
		<PurviewContainersAspireVersion>$(PurviewContainersVersion)</PurviewContainersAspireVersion>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Transitive pinning is on, so a project that runs on the 17 line (it references
			Aspire.Hosting.AppHost or .Testing) sets UseAspireAppHostVersion=true in its .csproj; items
			evaluate after every property, so the switch is seen here. Everything else pins the floor.
		-->
		<PackageVersion
			Include="Aspire.Hosting"
			Version="$(AspireVersion)"
			Condition="'$(UseAspireAppHostVersion)' != 'true'"
		/>
		<PackageVersion
			Include="Aspire.Hosting"
			Version="$(AspireAppHostVersion)"
			Condition="'$(UseAspireAppHostVersion)' == 'true'"
		/>
		<!-- Environment has no Aspire dependency; Containers.Aspire is referenced by the sample AppHosts only. -->
		<PackageVersion Include="Purview.Containers.Environment" Version="$(PurviewContainersVersion)" />
		<PackageVersion Include="Purview.Containers.Aspire" Version="$(PurviewContainersAspireVersion)" />
		<PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireAppHostVersion)" />
		<PackageVersion Include="Aspire.Hosting.Dotnet" Version="$(AspireAppHostVersion)" />
		<PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireAppHostVersion)" />
		<PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireAppHostVersion)" />
		<PackageVersion Include="Aspire.Hosting.Azure.PostgreSQL" Version="$(AspireAppHostVersion)" />
		<PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="$(AspireAppHostVersion)" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynCompilerVersion)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(RoslynAnalyzersVersion)" />
		<!--
			Public-API baseline for the two shipped runtime packages. 13.6.5 is the first stable
			release, so its surface is the compatibility contract: an accidental removal or signature
			change now fails the build instead of reaching consumers.
		-->
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
		<PackageVersion Include="Purview.SourceGeneratorFramework" Version="$(PurviewSourceGenVersion)" />
		<PackageVersion Include="Purview.SourceGeneratorFramework.Testing.TUnit" Version="$(PurviewSourceGenVersion)" />
		<PackageVersion Include="Purview.Telemetry.SourceGenerator" Version="$(PurviewTelemetryVersion)" />

		<!--
			Sample EF Core data projects only. Relational carries the fluent API the generator
			interprets (ToTable, HasDefaultSchema, HasColumnName, HasColumnType).
		-->
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />

		<!-- Relational provider used only by the model-dump projector tests. -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />

		<!--
			AppHost-side, metadata-only reflection over a service's build output. Loads types without
			executing any code in the target assembly, which is how a DbContext is discovered when the
			service project has not referenced the AspireC4.EntityFrameworkCore analyzer.
		-->
		<PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />

		<!-- Testing packages -->
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Aspire" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Core" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<PackageVersion Include="Purview.Skills.Testing" Version="2.1.0" />
	</ItemGroup>
</Project>
