{
	"Build": {
		"Solution": "src/AspireC4.slnx",
		"TestRoot": "src/tests",
		"TestPatterns": "*Tests.csproj",
		"TestFilter": "/*/*/*/*"
	},
	"PackValidation": {
		// AspireC4.EntityFrameworkCore is analyzer-only (IncludeBuildOutput=false), so NuGet produces
		// no .snupkg for it, and it no longer embeds a PDB under analyzers/dotnet/ - which is the only
		// thing that exempts a package from the symbol-package requirement. The PDB was dropped
		// because the merge pass strips the compiler-flags record the validator demands; see
		// EntityFrameworkCore.Analyzers.csproj. Re-enable this once that analyzer can ship symbols
		// again, as the two library packages do produce .snupkg files and are no longer checked.
		"RequireSymbolPackage": false,
		"RequireSymbolFiles": true,
		// These three are the tool's documented shipped defaults (false/false/[]), stated explicitly
		// because the pinned tool otherwise falls back to its C# initialisers (true/true/
		// ["optimization=release"]). Any one of them being enabled turns on assembly inspection,
		// which fails the analyzer-only package: the PDB embedded under analyzers/dotnet/ carries no
		// compiler-flags record. Turn these back on once every packed assembly satisfies them.
		"RequireSourceLink": false,
		"RequireDeterministic": false,
		// Explicit because Purview.Build 0.5.3 defaults RequiredCompilerFlags to empty. Earlier
		// versions forced this check on and could not be configured off, so these packages have
		// always been validated against it; declaring it keeps that behaviour. The analyzer-only
		// package is unaffected either way: it ships no PDB, so it is never inspected.
		"RequiredCompilerFlags": [
			"optimization=release"
		],
		// RequireExplicitContent defaults to true, so this is the exhaustive declaration of what each
		// package ships: a package with no rule here, or an entry matching none of its globs, fails
		// validation. $(TFM) expands to every target framework the package ships, so the lib/ rules
		// follow Purview.BuildSdk's set (net10.0;net11.0 today) with nothing to edit when it changes.
		"RequiredContent": {
			// The Aspire integration: the library, the registry/DSL source generator, and the props
			// file that wires the generator up in a consuming AppHost. The generator is not a package
			// of its own: AspireC4.csproj references src/src/SourceGenerators as an analyzer, and pack
			// places it under analyzers/dotnet/cs/ automatically. This rule is what proves it shipped.
			"aspirec4.hosting": [
				"analyzers/dotnet/cs/Aspire.Hosting.AspireC4.SourceGenerators.dll",
				"build/AspireC4.Hosting.props",
				"lib/$(TFM)/Aspire.Hosting.AspireC4.dll",
				"lib/$(TFM)/Aspire.Hosting.AspireC4.xml",
				"likec4-logo.png",
				"README.md"
			],
			// The AppHost-side EF Core to d2 ER diagram library. Library only: its generator ships as
			// the separate analyzer-only AspireC4.EntityFrameworkCore package below, and the opt-in
			// build-time dump as AspireC4.EntityFrameworkCore.ModelDump.
			"aspirec4.hosting.entityframeworkcore": [
				"lib/$(TFM)/Aspire.Hosting.AspireC4.EntityFrameworkCore.dll",
				"lib/$(TFM)/Aspire.Hosting.AspireC4.EntityFrameworkCore.xml",
				"likec4-logo.png",
				"README.md"
			],
			// The opt-in build-time model dump, referenced by the project that owns the EF Core
			// provider. Ships the MSBuild target that runs it and the tool itself under tools/; nothing
			// it writes leaves obj/, so there is no deployment footprint.
			"aspirec4.entityframeworkcore.modeldump": [
				"build/AspireC4.EntityFrameworkCore.ModelDump.targets",
				"tools/**",
				"likec4-logo.png",
				"README.md"
			],
			// Analyzer-only: referenced by service projects (where the DbContext lives), so it ships no
			// lib/ assembly and, by way of PurviewPackAnalyzerPdb=false, no PDB either.
			"aspirec4.entityframeworkcore": [
				"analyzers/dotnet/cs/Aspire.Hosting.AspireC4.EntityFrameworkCore.Analyzers.dll",
				"likec4-logo.png",
				"README.md"
			]
		},
		"ForbiddenContent": {}
	},
	"Release": {
		"Mode": "None"
	}
}